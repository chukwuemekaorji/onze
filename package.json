{
  "name": "onze",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Fantasy Premier League coach",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vercel dev",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build:web",
    "data:build": "tsx scripts/data/build.ts",
    "data:fixture": "tsx scripts/data/make-fixture.ts",
    "data:prior": "tsx scripts/data/live-prior.ts && prettier --write lib/projection-prior.ts",
    "eval:baselines": "tsx scripts/eval/baselines.ts && prettier --write results/baselines.md",
    "eval:projection": "tsx scripts/eval/projection.ts && prettier --write results/projection.md lib/analysis/projection-weights.ts",
    "eval:events": "tsx scripts/eval/events.ts && prettier --write results/events.md lib/analysis/event-weights.ts",
    "eval:defensive": "tsx scripts/eval/defensive-contributions.ts && prettier --write results/defensive-contributions.md",
    "eval:ensemble": "tsx scripts/eval/ensemble.ts && prettier --write results/ensemble.md",
    "eval:test:register": "tsx scripts/eval/test-season.ts register && prettier --write results/test-2025-26.md",
    "eval:test:rehearse": "tsx scripts/eval/test-season.ts rehearse",
    "eval:test": "tsx scripts/eval/test-season.ts score && prettier --write results/test-2025-26.md",
    "backtest:register": "tsx scripts/backtest/run.ts register && prettier --write results/decision-backtest.md",
    "backtest:rehearse": "tsx scripts/backtest/run.ts rehearse",
    "backtest": "tsx scripts/backtest/run.ts run && prettier --write results/decision-backtest.md"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@vercel/node": "^3.2.24",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vercel": "^64.3.1",
    "vite": "^8.3.8",
    "vitest": "^2.1.8"
  }
}
